# PostgreSQL (used by docker compose + the app)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=opencodeapp
POSTGRES_PASSWORD=opencodeapp_secret
POSTGRES_DB=opencodeapp

DATABASE_URL=postgresql://opencodeapp:opencodeapp_secret@localhost:5434/opencodeapp

# API
API_PORT=3011
API_SECRET=change_this_secret_in_production

# Frontend
WEB_PORT=3010
FRONTEND_URL=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:3011

# Extensions directory (relative to repo root)
TENANTS_DIR=tenants
