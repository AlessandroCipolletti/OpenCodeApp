{
  "name": "opencodeapp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "docker-compose up",
    "db:migrate": "npm run migrate -w packages/opencodeapp-db",
    "db:generate": "npm run generate -w packages/opencodeapp-db"
  },
  "engines": {
    "node": ">=18"
  }
}
